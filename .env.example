OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
CORS_ORIGINS=https://your-vercel-project.vercel.app
BOOKING_PROVIDER=booksy
PARSE_API_KEY=replace-with-your-parse-api-key
# Parse dashboard scraper/API ID (kept for reference and backwards compatibility).
PARSE_BOOKSY_API_ID=1f72a8f2-667d-4949-9532-4a90d656f7af
# Canonical endpoint used by direct HTTP requests. Do not replace this with the dashboard scraper ID.
PARSE_BOOKSY_ENDPOINT_ID=f0902cfa-08ee-43d3-a91b-f350352983ff
PARSE_API_SNAPSHOT_VERSION=4
BOOKSY_BUSINESS_ID=1841792
# Optional. When omitted, the backend derives <business-booking-link>/staffer/<id>#ba_s=dl_1.
BOOKSY_STAFF_BOOKING_URL_TEMPLATE=
